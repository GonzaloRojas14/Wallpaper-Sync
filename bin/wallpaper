#!/usr/bin/env bash
# wallpaper — motor de fondos animados para macOS.
# Todos los videos se guardan en formato HEVC (.mov) para máxima compatibilidad.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# ── Rutas ──────────────────────────────────────────────────────────────
# BUNDLE_ROOT = donde están los ejecutables (dentro de la .app o en el repo)
if [ -n "${APP_BUNDLE_RESOURCES:-}" ]; then
  BUNDLE_ROOT="$APP_BUNDLE_RESOURCES"
else
  BUNDLE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# ROOT = datos del usuario (escritura)
ROOT="$HOME/Library/Application Support/WallpaperSync"
mkdir -p "$ROOT/library" "$ROOT/logs"

APP="$BUNDLE_ROOT/app/WallpaperEngine"
CFG="$ROOT/config.json"
LIB="$ROOT/library"
LOG="$ROOT/logs/engine.log"
PID="$ROOT/logs/engine.pid"
AGENT_LABEL="local.wallpaper.engine"
AGENT_PLIST="$HOME/Library/LaunchAgents/${AGENT_LABEL}.plist"

FFMPEG="$(command -v ffmpeg || true)"

# ── Config helpers ─────────────────────────────────────────────────────
ensure_cfg() {
  if [ ! -f "$CFG" ]; then
    cat > "$CFG" <<JSON
{
  "activeName": "",
  "fill": "fill",
  "language": "",
  "pauseOnBattery": false,
  "pauseOnLowPower": false,
  "powerSavingMode": false,
  "video": ""
}
JSON
  fi
}

cfg_get() {
  /usr/bin/python3 - "$CFG" "$1" <<'PY'
import json,sys
v=json.load(open(sys.argv[1])).get(sys.argv[2],"")
if isinstance(v,bool): print("true" if v else "false")
else: print(v)
PY
}

cfg_set() {
  local key="$1" val="$2"
  /usr/bin/python3 - "$CFG" "$key" "$val" <<'PY'
import json,sys
p,k,v=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(p))
if v in ("true","false"): d[k] = (v=="true")
else: d[k] = v
open(p,"w").write(json.dumps(d,indent=2,sort_keys=True))
PY
}

# ── i18n ───────────────────────────────────────────────────────────────
# Agregar un idioma = agregar bin/i18n/<código>.sh. No hay que tocar nada más:
# el catálogo inglés se sourcea siempre primero, así que las claves que falten
# caen a inglés una por una. Ver docs/TRANSLATING.md.
detect_lang() {
  local code="${WALLPAPER_LANG:-}"

  # El HUD guarda el idioma elegido acá, así CLI y app van sincronizadas.
  if [ -z "$code" ] && [ -f "$CFG" ]; then
    code="$(cfg_get language 2>/dev/null || true)"
  fi

  # Preferencia de macOS: ("en-GB", "es") → en-GB
  if [ -z "$code" ]; then
    code="$(defaults read -g AppleLanguages 2>/dev/null | tr -d ' \n"()' | cut -d, -f1)"
  fi

  [ -n "$code" ] || code="${LANG:-}"
  code="${code%%_*}"   # es_AR.UTF-8 → es
  code="${code%%-*}"   # en-GB       → en (los catálogos son por idioma)
  echo "${code:-en}"
}

. "$BUNDLE_ROOT/bin/i18n/en.sh"
LANG_CODE="$(detect_lang)"
if [ "$LANG_CODE" != "en" ] && [ -f "$BUNDLE_ROOT/bin/i18n/${LANG_CODE}.sh" ]; then
  . "$BUNDLE_ROOT/bin/i18n/${LANG_CODE}.sh"
fi

# t <clave> [args…] — resuelve la clave y la formatea. Sin traducción, imprime
# la clave cruda, que es más útil que una línea en blanco.
# shellcheck disable=SC2059  # el formato viene del catálogo, es intencional
t() {
  local var="MSG_$1" fmt
  fmt="${!var:-}"
  [ -n "$fmt" ] || fmt="$1"
  shift
  printf "$fmt" "$@"
}

say()  { printf '%s\n' "$(t "$@")"; }
info() { printf '·· %s\n' "$(t "$@")"; }
die()  { printf 'error: %s\n' "$(t "$@")" >&2; exit 1; }

# ── Conversión a HEVC ──────────────────────────────────────────────────
# Se hace UNA SOLA VEZ al agregar un video. Después, todo es copiar archivos.
convert_to_hevc_mov() {
  local src="$1" dst="$2"
  [ -n "$FFMPEG" ] || die need_ffmpeg

  # Si ya es HEVC, solo reempaquetar como .mov
  local codec
  codec=$("$FFMPEG" -i "$src" -hide_banner 2>&1 | grep -o 'hevc\|h265' | head -1 || true)
  if [ -n "$codec" ]; then
    info already_hevc
    "$FFMPEG" -hide_banner -loglevel error -y -i "$src" \
      -c copy -tag:v hvc1 -movflags +faststart -an -f mov "$dst"
    return 0
  fi

  info encoding
  local vf='scale=trunc(iw/2)*2:trunc(ih/2)*2'
  if "$FFMPEG" -hide_banner -loglevel error -y -i "$src" \
      -c:v hevc_videotoolbox -tag:v hvc1 -q:v 55 -pix_fmt yuv420p \
      -vf "$vf" -movflags +faststart -an -f mov "$dst" 2>/dev/null; then
    info encoded_ok
    return 0
  fi

  info encode_fallback
  "$FFMPEG" -hide_banner -loglevel error -y -i "$src" \
    -c:v libx265 -tag:v hvc1 -preset fast -crf 26 -pix_fmt yuv420p \
    -vf "$vf" -movflags +faststart -an -f mov "$dst"
}

# ── Sync lock screen ──────────────────────────────────────────────────
# El video YA está en HEVC, solo lo copiamos atómicamente al slot del aerial.
sync_lockscreen() {
  local video="$1"
  [ -f "$video" ] || return 0
  info syncing_lockscreen
  /usr/bin/python3 "$BUNDLE_ROOT/bin/_set_lockscreen_video.py" "$video" 2>&1 || true
}

# ── Engine control ────────────────────────────────────────────────────
is_running() {
  [ -f "$PID" ] || return 1
  local p; p="$(cat "$PID" 2>/dev/null)"
  [ -n "$p" ] || return 1
  kill -0 "$p" 2>/dev/null || { rm -f "$PID"; return 1; }
  # Verificar que el PID corresponde a WallpaperEngine y no a un proceso
  # que reciclo ese PID despues de que el motor murio.
  ps -p "$p" -o comm= 2>/dev/null | grep -q "WallpaperEngine$" || { rm -f "$PID"; return 1; }
}

cmd_start() {
  ensure_cfg
  [ -x "$APP" ] || die binary_missing "$APP"
  local vid; vid="$(cfg_get video)"
  [ -n "$vid" ] || die no_active
  if is_running; then info already_running "$(cat "$PID")"; return 0; fi
  nohup "$APP" "$CFG" >>"$LOG" 2>&1 &
  echo $! > "$PID"
  sleep 0.3
  is_running || die start_failed "$LOG"
  info started "$(cat "$PID")"

  # Resincronizar el slot del lock screen al video actual. Sin esto, después
  # de un reboot el sistema sigue mostrando el último video que se haya
  # sincronizado manualmente (con `wallpaper use` o `set`), no el activo.
  sync_lockscreen "$vid"
}

cmd_stop() {
  local killed=0
  if is_running; then
    local p; p="$(cat "$PID")"
    kill "$p" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      kill -0 "$p" 2>/dev/null || { killed=1; break; }
      sleep 0.2
    done
    [ $killed -eq 1 ] || kill -9 "$p" 2>/dev/null || true
    rm -f "$PID"
  fi
  pkill -9 -f "WallpaperEngine" 2>/dev/null || true
  info stopped
}

cmd_restart() { cmd_stop; cmd_start; }

# ── Biblioteca ────────────────────────────────────────────────────────
cmd_add() {
  local src="${1:-}"; [ -n "$src" ] || die usage_add
  [ -f "$src" ] || die not_found "$src"
  local base; base="$(basename "$src")"
  local stem="${base%.*}"
  local dst="$LIB/${stem}.mov"

  case "$src" in
    *.mov|*.MOV)
      # Verificar si ya es HEVC
      local codec
      codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$src" 2>/dev/null || true)
      if [ "$codec" = "hevc" ]; then
        info already_hevc_mov
        cp -f "$src" "$dst"
      else
        convert_to_hevc_mov "$src" "$dst"
      fi
      ;;
    *.mp4|*.MP4|*.m4v|*.M4V)
      convert_to_hevc_mov "$src" "$dst"
      ;;
    *.gif|*.GIF|*.webm|*.WEBM)
      convert_to_hevc_mov "$src" "$dst"
      ;;
    *) die unsupported_format "$base" ;;
  esac
  info added "$stem"
}

cmd_use() {
  ensure_cfg
  local name="${1:-}"; [ -n "$name" ] || die usage_use

  # Buscar el .mov en la biblioteca
  local match=""
  for f in "$LIB/${name}.mov"; do
    [ -f "$f" ] && { match="$f"; break; }
  done
  [ -n "$match" ] || die not_in_library "$name"

  # Actualizar config — el engine lo detecta automáticamente via checkConfig
  cfg_set video "$match"
  cfg_set activeName "$name"

  # Sincronizar lock screen (copia atómica, ya es HEVC)
  sync_lockscreen "$match"

  info active_now "$name"

  # Si el engine no está corriendo, arrancarlo
  if ! is_running; then
    cmd_start
  fi
}

cmd_set() {
  local src="${1:-}"; [ -n "$src" ] || die usage_set
  [ -f "$src" ] || die not_found "$src"
  local base; base="$(basename "$src")"
  local stem="${base%.*}"

  # Agregar a la biblioteca (convierte a HEVC si es necesario)
  cmd_add "$src"

  # Activar
  cmd_use "$stem"
}

cmd_list() {
  [ -d "$LIB" ] || { say library_empty; return 0; }
  ensure_cfg
  local active_name; active_name="$(cfg_get activeName)"
  shopt -s nullglob nocaseglob
  local any=0
  for f in "$LIB"/*.mov; do
    any=1
    local base; base="$(basename "$f")"
    local stem="${base%.*}"
    local size; size="$(du -h "$f" | cut -f1 | xargs)"
    local mark="  "
    [ "$stem" = "$active_name" ] && mark="▶ "
    echo "${mark}${stem}    [${size}]"
  done
  [ $any -eq 1 ] || say library_empty_hint
}

cmd_remove() {
  local name="${1:-}"; [ -n "$name" ] || die usage_remove
  local src="$LIB/${name}.mov"
  [ -f "$src" ] || die not_found "$name"
  rm -f "$src"
  info removed "$name"
}

cmd_status() {
  ensure_cfg
  echo "video:           $(cfg_get video)"
  echo "fill:            $(cfg_get fill)"
  echo "pauseOnBattery:  $(cfg_get pauseOnBattery)"
  echo "pauseOnLowPower: $(cfg_get pauseOnLowPower)"
  echo "powerSavingMode: $(cfg_get powerSavingMode)"
  echo "activeName:      $(cfg_get activeName)"
  # Preferencia guardada (vacía = seguir al sistema) y código realmente en uso.
  local lang_pref; lang_pref="$(cfg_get language)"
  echo "language:        ${lang_pref:-auto} (${LANG_CODE})"
  if is_running; then
    say state_running "$(cat "$PID")"
  else
    say state_stopped
  fi
  [ -f "$AGENT_PLIST" ] && say autostart_yes || say autostart_no
}

cmd_fill() {
  local m="${1:-}"
  case "$m" in
    fill|fit|stretch) cfg_set fill "$m"; info fill_set "$m"; is_running && cmd_restart || true ;;
    *) die usage_fill ;;
  esac
}

cmd_battery() {
  case "${1:-}" in
    on) cfg_set pauseOnBattery true; info battery_pause on ;;
    off) cfg_set pauseOnBattery false; info battery_pause off ;;
    *) die usage_battery ;;
  esac
  is_running && cmd_restart || true
}

cmd_lowpower() {
  case "${1:-}" in
    on) cfg_set pauseOnLowPower true; info lowpower_pause on ;;
    off) cfg_set pauseOnLowPower false; info lowpower_pause off ;;
    *) die usage_lowpower ;;
  esac
  is_running && cmd_restart || true
}

cmd_powersave() {
  case "${1:-}" in
    on) cfg_set powerSavingMode true; info powersave_set on ;;
    off) cfg_set powerSavingMode false; info powersave_set off ;;
    *) die usage_powersave ;;
  esac
  # The engine listens to this config change dynamically, no need to restart
}

# ── Autoarranque ──────────────────────────────────────────────────────
write_agent() {
  mkdir -p "$(dirname "$AGENT_PLIST")"
  cat > "$AGENT_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${AGENT_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${APP}</string>
    <string>${CFG}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>${LOG}</string>
  <key>StandardErrorPath</key><string>${LOG}</string>
</dict>
</plist>
PLIST
}

cmd_enable() {
  [ -x "$APP" ] || die binary_missing "$APP"
  cmd_stop || true
  write_agent
  launchctl unload "$AGENT_PLIST" 2>/dev/null || true
  launchctl load "$AGENT_PLIST"
  info autostart_installed
}

cmd_disable() {
  if [ -f "$AGENT_PLIST" ]; then
    launchctl unload "$AGENT_PLIST" 2>/dev/null || true
    rm -f "$AGENT_PLIST"
    info autostart_removed
  else
    info autostart_absent
  fi
}

cmd_logs() { tail -n "${1:-80}" "$LOG" 2>/dev/null || say no_logs; }

cmd_lockscreen() {
  local vid; vid="$(cfg_get video)"
  [ -n "$vid" ] && [ -f "$vid" ] || die no_active
  /usr/bin/python3 "$BUNDLE_ROOT/bin/_set_lockscreen_video.py" "$vid"
}

cmd_test() {
  ensure_cfg
  [ -x "$APP" ] || die binary_missing "$APP"
  local vid; vid="$(cfg_get video)"
  [ -n "$vid" ] || die no_active
  cmd_stop || true
  info sanity
  "$APP" "$CFG" --sanity 2>&1 | tee -a "$LOG"
}

# ── Dispatch ──────────────────────────────────────────────────────────
usage() { say usage; }

cmd="${1:-}"; shift || true
case "$cmd" in
  set)       cmd_set "$@" ;;
  use)       cmd_use "$@" ;;
  add)       cmd_add "$@" ;;
  list|ls)   cmd_list ;;
  remove|rm) cmd_remove "$@" ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  status)    cmd_status ;;
  logs)      cmd_logs "$@" ;;
  test)      cmd_test ;;
  lockscreen|lock) cmd_lockscreen ;;
  lockscreen-restore) /usr/bin/python3 "$BUNDLE_ROOT/bin/_set_lockscreen_video.py" --restore ;;
  lockscreen-status) /usr/bin/python3 "$BUNDLE_ROOT/bin/_set_lockscreen_video.py" --status ;;
  fill)      cmd_fill "$@" ;;
  battery)   cmd_battery "$@" ;;
  lowpower)  cmd_lowpower "$@" ;;
  powersave) cmd_powersave "$@" ;;
  enable)    cmd_enable ;;
  disable)   cmd_disable ;;
  ""|help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
